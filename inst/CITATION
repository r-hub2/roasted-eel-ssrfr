citHeader("To cite the ssrfr package in publications, use:")

# meta is the parsed DESCRIPTION of the installed package. A fresh scaffold has
# no Date field, so fall back to the current year rather than emit "NA".
year <- sub("-.*", "", meta$Date)
if (!length(year) || is.na(year) || !nzchar(year)) {
  year <- format(Sys.Date(), "%Y")
}
note <- sprintf("R package version %s", meta$Version)

# After the package has a Zenodo DOI, add a
# `doi = "10.5281/zenodo.XXXXXXXX"` argument to the bibentry below.
bibentry(
  bibtype = "Manual",
  title   = "{ssrfr}: Server-Side Request Forgery Guard for Outbound Requests",
  author  = person("Bart", "Turczynski",
                   comment = c(ORCID = "0000-0002-8788-7980")),
  year    = year,
  note    = note,
  url     = "https://gitlab.com/bart-turczynski/ssrfr"
)
